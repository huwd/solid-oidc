{
  "name": "solid-oidc",
  "version": "0.0.0",
  "description": "A Solid-OIDC identity provider that brokers login to an upstream OpenID Connect provider such as Pocket ID",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run docs:lint",
    "dev": "node --watch src/bin/main.ts",
    "docs:lint": "markdownlint-cli2",
    "docs:prose": "git ls-files -z '*.md' | xargs --null vale",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "start": "node src/bin/main.ts",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-include-all --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/bin/**' --test-coverage-exclude='src/test-support/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 'src/**/*.test.ts'",
    "typecheck": "tsc",
    "workflows:audit": "zizmor --offline ."
  },
  "dependencies": {
    "koa": "3.3.0",
    "oidc-provider": "9.15.0",
    "openid-client": "6.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/koa": "3.0.3",
    "@types/node": "26.6.6",
    "@types/oidc-provider": "9.13.1",
    "markdownlint-cli2": "0.24.1",
    "typescript": "7.0.2"
  }
}
