{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git -c commit.gpgsign=false commit *)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create --draft *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Bash(git commit -s*)",
      "Bash(git commit * -s*)",
      "Bash(git commit --signoff*)",
      "Bash(git commit * --signoff*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main*)",
      "Bash(git push origin main*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr merge*)",
      "Bash(scripts/sign-off.sh*)",
      "Bash(bash scripts/sign-off.sh*)"
    ]
  }
}
